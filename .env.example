# Server port
PORT=3001

# Preferred option: full connection string.
# In VPS with Docker, use the internal service/container host, not a public IP.
# Example:
# DATABASE_URL=postgres://postgres:changeme@postgres:5432/pos_saas
DATABASE_URL=

# Alternative option: separate PG variables.
# These are used only when DATABASE_URL is empty.

# Local development example
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pos_saas
PGUSER=postgres
PGPASSWORD=changeme

# SSL mode: disable for local/internal Docker network, require for managed remote DBs if needed.
PGSSLMODE=disable

# Session signing secret for backend auth tokens
SESSION_SECRET=change-this-in-production

# Frontend -> backend base URL.
# Local example:
VITE_API_BASE_URL=http://127.0.0.1:3001
